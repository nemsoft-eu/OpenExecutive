      "id": "a02-owner-asks-mail-to-a-contact",
      "about": "Sam asks the Executive to tell Leo the holiday dock hours. Balanced: it goes.",
      "settings": {
        "level": "balanced"
      },
      "steps": [
        {
          "turn": {
            "who": "sam",
            "surface": "web",
            "ask": "Tell Leo Park our holiday dock hours: closed Dec 25 and Jan 1, otherwise 7am to 3pm.",
            "calls": [
              {
                "tool": "google_workspace__send_gmail_message",
                "mcp": true,
                "input": {
                  "to": "leo@brightwire.example",
                  "subject": "Holiday dock hours",
                  "body": "Hi Leo, our dock will be closed Dec 25 and Jan 1. The rest of those weeks we're open 7am to 3pm. Please schedule any deliveries accordingly.\n\nOpen Executive, on behalf of Lakeview"
                }
              }
            ]
          },
          "expect": {
            "steps": [
              "ran"
            ],
            "sent": 1,
            "views": []
          }
        }
      ]
    },
